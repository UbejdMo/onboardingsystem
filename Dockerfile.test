# Runs the unit test suite inside a container.
#
#   docker build -f Dockerfile.test -t merchant-tests . && docker run --rm merchant-tests
#
# Useful on any machine where the host blocks running locally-built binaries.
FROM mcr.microsoft.com/dotnet/sdk:10.0
WORKDIR /source

COPY src/MerchantOnboarding.Api/MerchantOnboarding.Api.csproj src/MerchantOnboarding.Api/
COPY tests/MerchantOnboarding.Tests/MerchantOnboarding.Tests.csproj tests/MerchantOnboarding.Tests/
RUN dotnet restore tests/MerchantOnboarding.Tests/MerchantOnboarding.Tests.csproj

COPY src/ src/
COPY tests/ tests/

ENTRYPOINT ["dotnet", "test", "tests/MerchantOnboarding.Tests/MerchantOnboarding.Tests.csproj", "--no-restore"]
